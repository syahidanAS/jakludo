# Port HTTP & Socket.IO
PORT=5172

# Set 1 jika berada di belakang Nginx / reverse proxy
TRUST_PROXY=0

# URL publik situs (tanpa garis miring di akhir), dipakai untuk canonical, og:url, sitemap, dan robots.txt.
# Wajib diisi di production, mis. https://playgo.domainkamu.com
PUBLIC_URL=

# Admin bank soal Monster Quiz (/api/quiz/questions): daftar username dipisah koma, dan/atau kunci
# rahasia yang dikirim lewat header X-Quiz-Admin-Key. Kosong = username "admin".
QUIZ_ADMIN_USERNAMES=
QUIZ_ADMIN_KEY=

# Admin aplikasi (ekonomi /api/admin/economy/* dan koreksi stok item & Coins /api/admin/users/:username/items):
# username dipisah koma, selain akun yang role-nya 'admin' di tabel users. Kosong = username "admin".
ADMIN_USERNAMES=

# Konfigurasi Container PostgreSQL (dipakai oleh docker-compose.yml & aplikasi)
POSTGRES_USER=jakludo
POSTGRES_PASSWORD=ganti_password_kuat_ini
POSTGRES_DB=jakludo
# Port di localhost host server (default 5433 agar tidak bentrok dengan PostgreSQL lain di port 5432)
POSTGRES_PORT=5433

# Konfigurasi MinIO / S3 Object Storage untuk foto & voice note di chat grup
# Isi dengan endpoint MinIO yang sudah berjalan (mis. http://100.119.33.113:9000 atau https://s3.domainkamu.com)
S3_ENDPOINT=
# Opsional: isi jika URL publik MinIO yang diakses browser pemain berbeda dari S3_ENDPOINT internal
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=jakludo
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SEC=600

# Google OAuth 2.0 / Sign-In with Google Client ID
# Dapatkan dari Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web Application)
GOOGLE_CLIENT_ID=

# Google reCAPTCHA v3 untuk proteksi formulir Login & Registrasi
# Dapatkan dari https://www.google.com/recaptcha/admin (pilih reCAPTCHA v3)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Payment Gateway aktif untuk Top Up Diamonds & Coins ('midtrans', 'doku', atau 'duitku')
PAYMENT_GATEWAY=midtrans

# Midtrans Payment Gateway (Core API Direct Charge - BUKAN SNAP)
# Dapatkan Server Key & Client Key dari Dashboard Midtrans Sandbox (https://dashboard.sandbox.midtrans.com)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false

# DOKU Payment Gateway (Jokul Checkout / Direct API) untuk Top Up Diamonds / Poin PlayGo
# Dapatkan Client ID & Secret Key dari Dashboard DOKU (https://dashboard.doku.com atau sandbox)
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_MERCHANT_CODE=
# Set 1 atau true untuk production, atau 0 / false untuk sandbox (default false)
DOKU_IS_PRODUCTION=false
DOKU_CALLBACK_URL=
DOKU_RETURN_URL=

# Duitku Payment Gateway (Direct API v2) untuk Top Up Diamonds / Poin PlayGo
# Dapatkan dari Dashboard Duitku (https://passport.duitku.com atau https://sandbox.duitku.com)
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
# Set 1 atau true untuk production, atau 0 / false untuk sandbox (default false)
DUITKU_IS_PRODUCTION=false
DUITKU_CALLBACK_URL=

# Batas pembelian tiap item toko per pemain per bulan (WIB). Skin kosmetik tidak termasuk. Default 10.
MONTHLY_ITEM_PURCHASE_LIMIT=10


# Basic Auth khusus endpoint registrasi user langsung dari Postman (POST /api/auth/register-basic)
BASIC_AUTH_REGISTER_USER=
BASIC_AUTH_REGISTER_PASS=
