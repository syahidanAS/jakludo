# Port HTTP & Socket.IO
PORT=5172

# Set 1 jika berada di belakang Nginx / reverse proxy
TRUST_PROXY=0

# URL publik situs (tanpa garis miring di akhir), dipakai untuk canonical, og:url, sitemap, dan robots.txt.
# Wajib diisi di production, mis. https://playgo.domainkamu.com
PUBLIC_URL=

# Admin bank soal Monster Quiz (/api/quiz/questions): daftar username dipisah koma, dan/atau kunci
# rahasia yang dikirim lewat header X-Quiz-Admin-Key. Kosong = tidak ada admin.
QUIZ_ADMIN_USERNAMES=
QUIZ_ADMIN_KEY=

# Konfigurasi Container PostgreSQL (dipakai oleh docker-compose.yml & aplikasi)
POSTGRES_USER=jakludo
POSTGRES_PASSWORD=ganti_password_kuat_ini
POSTGRES_DB=jakludo
# Port di localhost host server (default 5433 agar tidak bentrok dengan PostgreSQL lain di port 5432)
POSTGRES_PORT=5433

# Konfigurasi MinIO / S3 Object Storage untuk foto & voice note di chat grup
# Isi dengan endpoint MinIO yang sudah berjalan (mis. http://100.119.33.113:9000 atau https://s3.domainkamu.com)
S3_ENDPOINT=
# Opsional: isi jika URL publik MinIO yang diakses browser pemain berbeda dari S3_ENDPOINT internal
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=jakludo
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SEC=600

# Google OAuth 2.0 / Sign-In with Google Client ID
# Dapatkan dari Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web Application)
GOOGLE_CLIENT_ID=

# Duitku Payment Gateway (POP API) untuk Top Up Diamonds / Poin PlayGo
# Dapatkan dari Dashboard Duitku (https://passport.duitku.com atau https://sandbox.duitku.com)
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
# Set 1 atau true untuk production, atau 0 / false untuk sandbox (default false)
DUITKU_IS_PRODUCTION=false
DUITKU_CALLBACK_URL=
